# Server settings for NCD - PENPLUS STUDY (Docker). On the server: cp .env.production.example .env, then fill in.
# Never commit the real .env. Generate secrets with:  openssl rand -base64 48

# --- Django ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=penplus.tamris.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://penplus.tamris.org
DJANGO_TIME_ZONE=Africa/Dar_es_Salaam
SITE_URL=https://penplus.tamris.org
# Keep true. Set false only for a first test over plain HTTP (logins still need HTTPS: cookies are secure).
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=3600

# --- PostgreSQL (the penplus-db container; also used by docker-compose.yml) ---
DB_NAME=ncd_penplus
DB_USER=ncd_penplus
DB_PASSWORD=change-me

# --- Docker ---
# Port on 127.0.0.1 that the host nginx forwards penplus.tamris.org to (must be free on the server).
WEB_PORT=8090

# --- Programme rules ---
LTFU_MONTHS=3
HBA1C_INTERVAL_MONTHS=3
HBA1C_RETRY_MONTHS=1

# --- Email (file-based until go-live: nothing is sent) ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=sent_emails
# Hostinger mail (same as tamris):
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.hostinger.com
# EMAIL_PORT=465
# EMAIL_USE_SSL=true
# EMAIL_USE_TLS=false
# EMAIL_HOST_USER=info@tamris.org
# EMAIL_HOST_PASSWORD=<mailbox password>
# Or SendGrid: EMAIL_HOST=smtp.sendgrid.net, EMAIL_PORT=587, EMAIL_USE_TLS=true, EMAIL_HOST_USER=apikey
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL="NCD - PENPLUS STUDY <noreply@nimr.or.tz>"

# --- SMS (console = only logged; beem, africastalking or nextsms to really send) ---
# Easier: leave these blank and set the gateway in Administration -> SMS settings (keys stored encrypted).
SMS_BACKEND=console
SMS_SENDER_ID=
SMS_DEFAULT_CONTACT=
BEEM_API_KEY=
BEEM_SECRET_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
NEXTSMS_API_TOKEN=
NEXTSMS_USERNAME=
NEXTSMS_PASSWORD=

# --- Background jobs ---
EXPORT_RUNNER=celery
EXPORT_RETENTION_DAYS=7
