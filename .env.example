# Local development settings for the NCD Clinical & Research Management System.
# Template: copy to .env and fill in the values. Never commit the real .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Africa/Dar_es_Salaam
SITE_URL=http://127.0.0.1:8000

# --- Database (MySQL) ---
DB_ENGINE=mysql
DB_NAME=ncd_penplus
DB_USER=ncd_penplus
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# --- Old PEN-Plus EDCS database (read-only access, used by import_penplus_edcs) ---
EDCS_DB_HOST=localhost
EDCS_DB_PORT=3306
EDCS_DB_USER=ncd_penplus
EDCS_DB_PASSWORD=change-me
EDCS_DB_NAME=penplus

# --- Email (console = print emails in the terminal; use smtp for real sending) ---
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=NCD System <no-reply@nimr.or.tz>
