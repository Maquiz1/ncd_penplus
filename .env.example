# Local development settings for the NCD Clinical & Research Management System.
# Template: copy to .env and fill in the values. Never commit the real .env.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=Africa/Dar_es_Salaam
SITE_URL=http://127.0.0.1:8000

# --- Programme rules ---
# Default / lost to follow-up after this many months without an attended visit
LTFU_MONTHS=3

# --- Database (MySQL) ---
DB_ENGINE=mysql
DB_NAME=ncd_penplus
DB_USER=ncd_penplus
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=3306

# --- Old PEN-Plus EDCS database (read-only access, used by import_penplus_edcs) ---
EDCS_DB_HOST=localhost
EDCS_DB_PORT=3306
EDCS_DB_USER=ncd_penplus
EDCS_DB_PASSWORD=change-me
EDCS_DB_NAME=penplus

# --- Email ---
# Local: filebased = each email is saved as a file in sent_emails/ and nothing is delivered.
# Go-live (SendGrid, as on the herbal server): uncomment the SMTP block and comment out the filebased line.
# The public address used in links and the sender name can also be set in the app: Administration -> Email settings.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_FILE_PATH=sent_emails
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USE_TLS=true
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=<sendgrid-api-key>
EMAIL_TIMEOUT=15
DEFAULT_FROM_EMAIL="Afya NCD <noreply@nimr.or.tz>"

# --- SMS (console = only logged; beem or africastalking to really send) ---
SMS_BACKEND=console
SMS_SENDER_ID=
SMS_DEFAULT_CONTACT=
BEEM_API_KEY=
BEEM_SECRET_KEY=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
NEXTSMS_API_TOKEN=
NEXTSMS_USERNAME=
NEXTSMS_PASSWORD=

# --- Background jobs (Celery) ---
CELERY_BROKER_URL=redis://localhost:6379/1

# --- Data exports ---
# thread = run in the web process (local), celery = run on the worker (production), inline = tests
# EXPORT_RUNNER=celery
EXPORT_RETENTION_DAYS=7
